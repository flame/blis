if(EXISTS "${RECORD}")
    include("${RECORD}")
else()
    set(blis_rec_prefix "${PREFIX}")
    set(blis_rec_destdir "$ENV{DESTDIR}")
endif()
# A relative path would resolve against this process's directory and could
# delete from the wrong tree. The install writes absolute paths; the fallback
# has to give absolute ones too.
foreach(v blis_rec_prefix blis_rec_destdir)
    if(NOT "${${v}}" STREQUAL "" AND NOT IS_ABSOLUTE "${${v}}")
        message(
            FATAL_ERROR
            "uninstall: ${v} '${${v}}' is not absolute. Install again, or set an absolute CMAKE_INSTALL_PREFIX and DESTDIR."
        )
    endif()
endforeach()
set(ENV{DESTDIR} "${blis_rec_destdir}")
foreach(f IN ITEMS FILES DIRS)
    string(REPLACE "|" ";" ${f} "${${f}}")
    set(_abs_${f} "")
    foreach(i IN LISTS ${f})
        cmake_path(ABSOLUTE_PATH i BASE_DIRECTORY "${blis_rec_prefix}" OUTPUT_VARIABLE _a)
        list(APPEND _abs_${f} "${_a}")
    endforeach()
endforeach()
if(WHAT)
    foreach(v LIBDIR INCDIR)
        cmake_path(ABSOLUTE_PATH ${v} BASE_DIRECTORY "${blis_rec_prefix}")
    endforeach()
    include("${CMAKE_CURRENT_LIST_DIR}/make/BlisUninstallOld.cmake")
    return()
endif()
foreach(f IN LISTS _abs_FILES)
    message(STATUS "Uninstalling $ENV{DESTDIR}${f}")
    file(REMOVE "$ENV{DESTDIR}${f}")
endforeach()
foreach(d IN LISTS _abs_DIRS)
    message(STATUS "Uninstalling $ENV{DESTDIR}${d}")
    file(REMOVE_RECURSE "$ENV{DESTDIR}${d}")
endforeach()
