# Evaluates config/<name>/make_defs.mk directly, so the per-config flag
# variables track the stock upstream def files. The make dialect is closed:
# ':=' and '+=' on plain variables, ifeq/ifneq/else/else-if/endif, $(var)
# references, $(findstring), $(shell), $(error), $(info), and the trailing
# $(eval $(call store-make-defs,...)) line, a no-op here since the loader
# captures the variables itself. A line outside the dialect aborts the parse.

# Splits <text> at its first comma outside any parentheses.
function(blis_make_split_args text outa outb)
    string(LENGTH "${text}" tlen)
    set(depth 0)
    set(i 0)
    while(i LESS tlen)
        string(SUBSTRING "${text}" ${i} 1 ch)
        if(ch STREQUAL "(")
            math(EXPR depth "${depth} + 1")
        elseif(ch STREQUAL ")")
            math(EXPR depth "${depth} - 1")
        elseif(ch STREQUAL "," AND depth EQUAL 0)
            break()
        endif()
        math(EXPR i "${i} + 1")
    endwhile()
    if(i EQUAL tlen)
        message(FATAL_ERROR "BlisMakeDefs: no top-level comma in: ${text}")
    endif()
    string(SUBSTRING "${text}" 0 ${i} a)
    math(EXPR bstart "${i} + 1")
    string(SUBSTRING "${text}" ${bstart} -1 b)
    string(STRIP "${a}" a)
    string(STRIP "${b}" b)
    set(${outa} "${a}" PARENT_SCOPE)
    set(${outb} "${b}" PARENT_SCOPE)
endfunction()

# Expands make references in <in>: plain $(var) lookups (undefined is
# empty, as in make), $(findstring needle,hay), and $(shell cmd) run
# through sh so pipes and quoting behave as they do under make. $(info)
# expands to the empty string. Anything else is rejected.
function(blis_make_expand in out)
    set(res "")
    set(rest "${in}")
    while(TRUE)
        string(FIND "${rest}" "$(" pos)
        if(pos EQUAL -1)
            string(APPEND res "${rest}")
            break()
        endif()
        string(SUBSTRING "${rest}" 0 ${pos} pre)
        string(APPEND res "${pre}")
        math(EXPR bstart "${pos} + 2")
        string(LENGTH "${rest}" rlen)
        set(depth 1)
        set(close -1)
        set(i ${bstart})
        while(i LESS rlen)
            string(SUBSTRING "${rest}" ${i} 1 ch)
            if(ch STREQUAL "(")
                math(EXPR depth "${depth} + 1")
            elseif(ch STREQUAL ")")
                math(EXPR depth "${depth} - 1")
                if(depth EQUAL 0)
                    set(close ${i})
                    break()
                endif()
            endif()
            math(EXPR i "${i} + 1")
        endwhile()
        if(close EQUAL -1)
            message(FATAL_ERROR "BlisMakeDefs: unbalanced '$(...)' in: ${in}")
        endif()
        math(EXPR blen "${close} - ${bstart}")
        string(SUBSTRING "${rest}" ${bstart} ${blen} body)
        blis_make_expand("${body}" body)
        if(body MATCHES "^[A-Za-z0-9_]+$")
            string(APPEND res "${${body}}")
        elseif(body MATCHES "^findstring[ \t]+(.*)$")
            blis_make_split_args("${CMAKE_MATCH_1}" needle hay)
            string(FIND "${hay}" "${needle}" fpos)
            if(NOT fpos EQUAL -1)
                string(APPEND res "${needle}")
            endif()
        elseif(body MATCHES "^shell[ \t]+(.*)$")
            execute_process(
                COMMAND sh -c "${CMAKE_MATCH_1}"
                WORKING_DIRECTORY "${BLIS_SOURCE_DIR}"
                OUTPUT_VARIABLE shout
                ERROR_QUIET
                OUTPUT_STRIP_TRAILING_WHITESPACE
            )
            # make $(shell) folds inner newlines into single spaces.
            string(REGEX REPLACE "[\r\n]+" " " shout "${shout}")
            string(APPEND res "${shout}")
        elseif(body MATCHES "^info([ \t]+.*)?$")
            # make prints the argument at parse time; nothing carries it.
        else()
            message(FATAL_ERROR "BlisMakeDefs: unsupported make construct '$(${body})' in: ${in}")
        endif()
        math(EXPR rstart "${close} + 1")
        string(SUBSTRING "${rest}" ${rstart} -1 rest)
    endwhile()
    set(${out} "${res}" PARENT_SCOPE)
endfunction()

# Removes a make comment: the first '#' not preceded by a backslash and
# everything after it.
function(blis_make_strip_comment line out)
    string(LENGTH "${line}" n)
    set(off 0)
    set(result "${line}")
    while(off LESS n)
        string(SUBSTRING "${line}" ${off} -1 tail)
        string(FIND "${tail}" "#" hp)
        if(hp EQUAL -1)
            break()
        endif()
        math(EXPR abs "${off} + ${hp}")
        if(abs GREATER 0)
            math(EXPR ph "${abs} - 1")
            string(SUBSTRING "${line}" ${ph} 1 pc)
        else()
            set(pc "")
        endif()
        if(pc STREQUAL "\\")
            math(EXPR off "${abs} + 1")
        else()
            string(SUBSTRING "${line}" 0 ${abs} result)
            break()
        endif()
    endwhile()
    set(${out} "${result}" PARENT_SCOPE)
endfunction()

# eff <- TRUE only while every open branch on the conditional stack is active.
macro(_blis_stk_eff)
    set(eff TRUE)
    foreach(a IN LISTS stk_active)
        if(NOT a)
            set(eff FALSE)
        endif()
    endforeach()
endmacro()

# Evaluates config/<cfg>/make_defs.mk and leaves every variable the def
# file assigns in the caller's scope, exactly as a make include would.
function(blis_parse_make_defs cfg)
    set(mkfile "${BLIS_SOURCE_DIR}/config/${cfg}/make_defs.mk")
    if(NOT EXISTS "${mkfile}")
        message(FATAL_ERROR "BlisMakeDefs: no make_defs.mk for config '${cfg}'")
    endif()
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${mkfile}")
    endif()
    file(READ "${mkfile}" raw)
    string(REGEX REPLACE "\r\n" "\n" raw "${raw}")
    # Conditional stack, one triplet per level: parent-effective, a branch
    # of this level was already taken, current branch active.
    set(stk_pe "")
    set(stk_taken "")
    set(stk_active "")
    set(eff TRUE)
    set(assigned "")
    set(pending "")
    # Lines are split by hand: a CMake list cannot hold an element that ends
    # in a backslash, which is exactly what a make continuation line is.
    string(APPEND raw "\n")
    while(NOT raw STREQUAL "")
        string(FIND "${raw}" "\n" nl)
        string(SUBSTRING "${raw}" 0 ${nl} l)
        math(EXPR lstart "${nl} + 1")
        string(LENGTH "${raw}" rlen)
        math(EXPR rlen "${rlen} - ${lstart}")
        string(SUBSTRING "${raw}" ${lstart} ${rlen} raw)

        set(process TRUE)
        # Fold backslash continuations the way make does: one single space.
        if(l MATCHES "\\\\$")
            string(REGEX REPLACE "\\\\$" "" l "${l}")
            string(APPEND pending "${l} ")
            set(process FALSE)
        endif()
        if(process)
            set(l "${pending}${l}")
            set(pending "")
            blis_make_strip_comment("${l}" l)
            string(STRIP "${l}" l)
            if(l STREQUAL "")
                set(process FALSE)
            endif()
        endif()
        if(NOT process)
            continue()
        endif()

        set(condmatch FALSE)
        set(is_else FALSE)
        set(cond TRUE)
        set(condtext "${l}")
        if(l STREQUAL "else")
            set(is_else TRUE)
        elseif(l MATCHES "^else[ \t]+if")
            set(is_else TRUE)
            string(REGEX REPLACE "^else[ \t]+" "" condtext "${l}")
        endif()
        if(condtext MATCHES "^if(n?)eq[ \t]*\\((.*)\\)$")
            set(condmatch TRUE)
            set(negate "${CMAKE_MATCH_1}")
            set(args "${CMAKE_MATCH_2}")
        endif()
        if(condmatch)
            blis_make_split_args("${args}" ra rb)
            blis_make_expand("${ra}" ra)
            blis_make_expand("${rb}" rb)
            string(STRIP "${ra}" ra)
            string(STRIP "${rb}" rb)
            set(cond FALSE)
            if(ra STREQUAL rb)
                set(cond TRUE)
            endif()
            if(negate STREQUAL "n")
                if(cond)
                    set(cond FALSE)
                else()
                    set(cond TRUE)
                endif()
            endif()
        elseif(is_else AND NOT l STREQUAL "else")
            message(FATAL_ERROR "BlisMakeDefs: ${mkfile}: cannot parse line: ${l}")
        endif()

        if(condmatch OR is_else)
            if(is_else)
                list(POP_BACK stk_pe pe)
                list(POP_BACK stk_taken taken)
                list(POP_BACK stk_active prev)
                set(active FALSE)
                if(pe AND NOT taken AND cond)
                    set(active TRUE)
                    set(taken TRUE)
                endif()
                list(APPEND stk_pe "${pe}")
                list(APPEND stk_taken "${taken}")
                list(APPEND stk_active "${active}")
            else()
                set(active FALSE)
                if(eff AND cond)
                    set(active TRUE)
                endif()
                list(APPEND stk_pe "${eff}")
                list(APPEND stk_taken "${active}")
                list(APPEND stk_active "${active}")
            endif()
            _blis_stk_eff()
            continue()
        elseif(l STREQUAL "endif")
            list(POP_BACK stk_pe)
            list(POP_BACK stk_taken)
            list(POP_BACK stk_active)
            _blis_stk_eff()
            continue()
        endif()

        if(NOT eff)
            continue()
        endif()

        if(l MATCHES "^([A-Za-z0-9_]+)[ \t]*(:=|\\+=)[ \t]*(.*)$")
            set(var "${CMAKE_MATCH_1}")
            set(op "${CMAKE_MATCH_2}")
            blis_make_expand("${CMAKE_MATCH_3}" val)
            string(STRIP "${val}" val)
            list(APPEND assigned "${var}")
            if(op STREQUAL ":=")
                set(${var} "${val}")
            elseif(DEFINED ${var})
                set(${var} "${${var}} ${val}")
            else()
                set(${var} "${val}")
            endif()
        elseif(l MATCHES "^\\$\\(error[ \t]+(.*)\\)$")
            blis_make_expand("${CMAKE_MATCH_1}" msg)
            blis_defer_error("${msg}")
        elseif(l MATCHES "^\\$\\(info[ \t]" OR l MATCHES "^\\$\\(eval[ \t]")
            # No-op: the print is intentional noise only in make, and the
            # store-make-defs call is covered by the loader's own capture.
        else()
            message(FATAL_ERROR "BlisMakeDefs: ${mkfile}: cannot parse line: ${l}")
        endif()
    endwhile()
    if(stk_pe)
        message(FATAL_ERROR "BlisMakeDefs: ${mkfile}: unbalanced conditionals")
    endif()
    foreach(v IN LISTS assigned)
        set(${v} "${${v}}" PARENT_SCOPE)
    endforeach()
endfunction()
