# Parses config_registry and reproduces configure's registry semantics:
# family expansion to a fixpoint, duplicate removal keeping the LAST
# occurrence, kernel-set tracking ("subconfig/kset1/kset2" chains), and the
# kernel->subconfig map (singleton -> itself; name match -> kernel; else
# LAST subconfig in list order).

# blis_registry_parse(): fills BLIS_REG_CONFIG_<name> / BLIS_REG_KERNELS_<name>
# / BLIS_REG_RAW_KERNELS_<name> (lists, parent scope) and BLIS_REG_NAMES (all
# registered names).
function(blis_registry_parse)
    file(STRINGS "${BLIS_SOURCE_DIR}/config_registry" _lines)
    set(all_names "")
    foreach(line ${_lines})
        string(REGEX REPLACE "#.*$" "" line "${line}")
        string(STRIP "${line}" line)
        if(line STREQUAL "")
            continue()
        endif()
        if(NOT line MATCHES "^([a-zA-Z0-9_]+):[ \t]*(.*)$")
            message(FATAL_ERROR "config_registry: malformed line: ${line}")
        endif()
        set(name "${CMAKE_MATCH_1}")
        separate_arguments(entries UNIX_COMMAND "${CMAKE_MATCH_2}")
        # Each entry may be a chain "subconfig/k1/k2": the first element is the
        # subconfig name only; the kernel sets are the REMAINING elements.
        # Without a slash the subconfig and the (only) kernel set share the name.
        set(configs "")
        set(kernels "")
        foreach(e ${entries})
            string(REPLACE "/" ";" chain "${e}")
            list(GET chain 0 subconfig)
            list(APPEND configs "${subconfig}")
            list(LENGTH chain _clen)
            if(_clen GREATER 1)
                list(SUBLIST chain 1 -1 _krest)
                list(APPEND kernels ${_krest})
            else()
                list(APPEND kernels "${subconfig}")
            endif()
        endforeach()
        blis_dedup_last(kernels)
        set(_c_${name} "${configs}")
        set(_k_${name} "${kernels}")
        # The raw kernel list is exported because the fixpoint runs after the export.
        set(BLIS_REG_RAW_KERNELS_${name} "${kernels}" PARENT_SCOPE)
        list(APPEND all_names "${name}")
    endforeach()
    # configure's pass 1 drops blacklisted subconfigs from
    # umbrella entries before the fixpoint; singleton lists stay as written.
    blis_compute_blacklist(_bl)
    set(BLIS_BLACKLIST "${_bl}" PARENT_SCOPE)
    foreach(_n ${all_names})
        list(LENGTH _c_${_n} _len)
        if(NOT (_len EQUAL 1 AND "${_c_${_n}}" STREQUAL "${_n}"))
            foreach(_b ${_bl})
                list(REMOVE_ITEM _c_${_n} "${_b}")
                list(REMOVE_ITEM _k_${_n} "${_b}")
            endforeach()
        endif()
        set(BLIS_REG_CONFIG_${_n} "${_c_${_n}}" PARENT_SCOPE)
    endforeach()
    # Kernel-registry fixpoint: replace each family
    # name in a kernel list with that family's kernel set until a full pass
    # makes no non-singleton substitution. Entries iterate in sorted order,
    # like bash's ${!kernel_registry_*}; the inner loop walks the pre-
    # substitution list while each lookup uses the live value.
    set(_knames "${all_names}")
    list(SORT _knames)
    set(_iterate TRUE)
    while(_iterate)
        set(_iterate FALSE)
        foreach(_n ${_knames})
            if("${_n}" IN_LIST _k_${_n})
                continue() # singleton entries never substitute
            endif()
            foreach(_ker ${_k_${_n}})
                set(_kers "${_k_${_ker}}")
                if("${_kers}" STREQUAL "")
                    continue() # kernel set without a config entry (e.g. armv8a)
                endif()
                if(NOT "${_ker}" STREQUAL "${_kers}")
                    set(_new "")
                    foreach(_w ${_k_${_n}})
                        if(_w STREQUAL _ker)
                            list(APPEND _new ${_kers})
                        else()
                            list(APPEND _new "${_w}")
                        endif()
                    endforeach()
                    blis_dedup_last(_new)
                    set(_k_${_n} "${_new}")
                    if(NOT "${_ker}" IN_LIST _kers)
                        set(_iterate TRUE)
                    endif()
                endif()
            endforeach()
        endforeach()
    endwhile()
    foreach(_n ${all_names})
        set(BLIS_REG_KERNELS_${_n} "${_k_${_n}}" PARENT_SCOPE)
    endforeach()
    set(BLIS_REG_NAMES "${all_names}" PARENT_SCOPE)
endfunction()

# blis_registry_expand(<name> <out_configs> <out_kernels>)
# Expands families within families until fixpoint; dedup keeps LAST.
function(blis_registry_expand name out_configs out_kernels)
    if(NOT DEFINED BLIS_REG_CONFIG_${name})
        message(FATAL_ERROR "'${name}' is not a registered configuration. " "Valid names: ${BLIS_REG_NAMES}")
    endif()
    set(configs "${BLIS_REG_CONFIG_${name}}")
    set(kernels "${BLIS_REG_KERNELS_${name}}")
    set(changed TRUE)
    while(changed)
        set(changed FALSE)
        set(new_configs "")
        set(new_kernels "")
        foreach(c ${configs})
            # A member is itself a family when it maps to something other than (or
            # more than) itself.
            set(_is_fam FALSE)
            if(DEFINED BLIS_REG_CONFIG_${c})
                set(_members "${BLIS_REG_CONFIG_${c}}")
                list(LENGTH _members _n)
                if((_n GREATER 1) OR (NOT "${_members}" STREQUAL "${c}"))
                    set(_is_fam TRUE)
                endif()
            endif()
            if(_is_fam)
                set(changed TRUE)
                list(APPEND new_configs ${BLIS_REG_CONFIG_${c}})
                list(APPEND new_kernels ${BLIS_REG_KERNELS_${c}})
            else()
                list(APPEND new_configs "${c}")
                list(APPEND new_kernels "${BLIS_REG_KERNELS_${c}}")
            endif()
        endforeach()
        set(configs "${new_configs}")
        set(kernels "${new_kernels}")
    endwhile()
    # Dedup keeping LAST occurrence (mirrors configure's rm_duplicate_words).
    blis_dedup_last(configs)
    blis_dedup_last(kernels)
    set(${out_configs} "${configs}" PARENT_SCOPE)
    set(${out_kernels} "${kernels}" PARENT_SCOPE)
endfunction()

function(blis_dedup_last listvar)
    set(_in "${${listvar}}")
    set(_out "")
    foreach(x ${_in})
        list(FIND _out "${x}" _idx)
        if(_idx GREATER -1)
            list(REMOVE_AT _out ${_idx})
        endif()
        list(APPEND _out "${x}")
    endforeach()
    set(${listvar} "${_out}" PARENT_SCOPE)
endfunction()

# blis_kconfig_compute(<config_list>): sets BLIS_KCONFIG_MAP (list of
# "kernel:subconfig" pairs, kernels sorted) in the caller scope.
function(blis_kconfig_compute config_list)
    set(all_kernels "")
    foreach(c ${config_list})
        foreach(k ${BLIS_REG_KERNELS_${c}})
            list(APPEND KCAND_${k} "${c}")
            list(APPEND all_kernels "${k}")
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES all_kernels)
    list(SORT all_kernels)
    set(map "")
    foreach(k ${all_kernels})
        set(cands "${KCAND_${k}}")
        list(LENGTH cands n)
        list(FIND cands "${k}" idx)
        if(n EQUAL 1)
            list(GET cands 0 chosen)
        elseif(idx GREATER -1)
            set(chosen "${k}")
        else()
            list(GET cands -1 chosen)
        endif()
        list(APPEND map "${k}:${chosen}")
    endforeach()
    set(BLIS_KCONFIG_MAP "${map}" PARENT_SCOPE)
endfunction()

# blis_kconfig_for(<kernel> <out_var>): subconfig whose flags compile <kernel>.
function(blis_kconfig_for kernel out)
    foreach(pair ${BLIS_KCONFIG_MAP})
        if(pair MATCHES "^${kernel}:(.*)$")
            set(${out} "${CMAKE_MATCH_1}" PARENT_SCOPE)
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "kernel '${kernel}' not in KCONFIG_MAP")
endfunction()
