@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@BLIS_NEEDS_THREADS@)
    set(THREADS_PREFER_PTHREAD_FLAG ON)
    find_dependency(Threads)
endif()
if(@BLIS_NEEDS_OPENMP@)
    find_dependency(OpenMP)
endif()
if(@BLIS_NEEDS_MEMKIND@)
    find_library(MEMKIND_LIBRARY memkind)
    if(NOT MEMKIND_LIBRARY)
        set(blis_FOUND FALSE)
        set(blis_NOT_FOUND_MESSAGE "blis was built with memkind but libmemkind was not found")
        return()
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/blisTargets.cmake")

# The target carries the include dirs resolved from where blisTargets.cmake sits.
get_target_property(blis_INCLUDE_DIRS blis::blis INTERFACE_INCLUDE_DIRECTORIES)
set(blis_LIBRARIES blis::blis)

# Configuration metadata (used by plugins and other advanced consumers).
set(blis_VERSION "@BLIS_VERSION@")
set(blis_CONFIG_NAME "@BLIS_CONFIG_NAME@")
set(blis_CONFIG_LIST "@BLIS_CONFIG_LIST@")

@BLISPLUGIN_EXPORTS@

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/BlisPluginHelpers.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/BlisPluginHelpers.cmake")
endif()

check_required_components(blis)
