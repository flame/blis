# Record each tool the way configure records it: the raw value the user gave
# (via env or -D) when there is one, else the bare name of the first tool from
# configure's search list. CMake's resolved absolute paths would not match.
# configure treats an empty CC/CXX/FC as unset ([ -n ... ]); DEFINED does not.
if(NOT "$ENV{CC}" STREQUAL "")
    set(CC "$ENV{CC}")
elseif(DEFINED BLIS_CC_CMD)
    set(CC "${BLIS_CC_CMD}")
else()
    if(CMAKE_SYSTEM_NAME MATCHES "OpenBSD|FreeBSD")
        find_program(_blis_cc_pick NAMES cc clang gcc)
    else()
        find_program(_blis_cc_pick NAMES gcc clang cc)
    endif()
    if(_blis_cc_pick)
        get_filename_component(CC "${_blis_cc_pick}" NAME)
    else()
        set(CC "${CMAKE_C_COMPILER}")
    endif()
endif()
if(NOT "$ENV{CXX}" STREQUAL "")
    set(CXX "$ENV{CXX}")
elseif(CMAKE_CXX_COMPILER)
    set(CXX "${CMAKE_CXX_COMPILER}")
else()
    if(CMAKE_SYSTEM_NAME MATCHES "OpenBSD|FreeBSD")
        find_program(_blis_cxx_pick NAMES c++ clang++ g++)
    else()
        find_program(_blis_cxx_pick NAMES g++ clang++ c++)
    endif()
    if(_blis_cxx_pick)
        get_filename_component(CXX "${_blis_cxx_pick}" NAME)
    else()
        set(CXX "")
    endif()
endif()
if(NOT "$ENV{FC}" STREQUAL "")
    set(FC "$ENV{FC}")
else()
    find_program(_blis_fc_pick NAMES gfortran ifort ifx nvfortran)
    if(_blis_fc_pick)
        get_filename_component(FC "${_blis_fc_pick}" NAME)
    else()
        set(FC "")
    endif()
endif()
if(DEFINED BLIS_AR_CMD)
    set(AR "${BLIS_AR_CMD}")
else()
    find_program(_blis_ar_pick NAMES ar)
    if(_blis_ar_pick)
        get_filename_component(AR "${_blis_ar_pick}" NAME)
    else()
        set(AR "${CMAKE_AR}")
    endif()
endif()
if(DEFINED BLIS_RANLIB_CMD)
    set(RANLIB "${BLIS_RANLIB_CMD}")
else()
    find_program(_blis_ranlib_pick NAMES ranlib)
    if(_blis_ranlib_pick)
        get_filename_component(RANLIB "${_blis_ranlib_pick}" NAME)
    else()
        set(RANLIB "${CMAKE_RANLIB}")
    endif()
endif()
if(DEFINED BLIS_PYTHON_CMD)
    set(PYTHON "${BLIS_PYTHON_CMD}")
else()
    find_program(_blis_py_pick NAMES python python3 python2)
    if(_blis_py_pick)
        get_filename_component(PYTHON "${_blis_py_pick}" NAME)
    else()
        set(PYTHON "${Python3_EXECUTABLE}")
    endif()
endif()
