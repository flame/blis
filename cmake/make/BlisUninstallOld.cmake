set(_d "$ENV{DESTDIR}${LIBDIR}")
if(DARWIN)
    set(_so "dylib")
    set(_full "${_d}/libblis.?.?.?.dylib")
    set(_cur "${_d}/libblis.${SO_MMB}.dylib")
    set(_maj "${_d}/libblis.?.dylib")
    set(_curmaj "${_d}/libblis.${SO_MAJOR}.dylib")
else()
    set(_so "so")
    set(_full "${_d}/libblis.so.?.?.?")
    set(_cur "${_d}/libblis.so.${SO_MMB}")
    set(_maj "${_d}/libblis.so.?")
    set(_curmaj "${_d}/libblis.so.${SO_MAJOR}")
endif()

set(_old "")
if(WHAT STREQUAL "libs")
    # Static libraries are overwritten by newer ones, so only versioned shared
    # libraries other than the current one are old.
    file(GLOB _old "${_full}")
    list(REMOVE_ITEM _old "${_cur}")
elseif(WHAT STREQUAL "symlinks")
    file(GLOB _old "${_maj}")
    list(REMOVE_ITEM _old "${_curmaj}")
    # Older-style names that carry a BLIS version and configuration family.
    file(GLOB _named "${_d}/libblis-*.a" "${_d}/libblis-*.${_so}")
    list(APPEND _old ${_named})
elseif(WHAT STREQUAL "headers")
    file(GLOB _old "$ENV{DESTDIR}${INCDIR}/blis/*.h")
    list(FILTER _old EXCLUDE REGEX "/(blis|cblas)\\.h$")
else()
    message(FATAL_ERROR "BlisUninstallOld: WHAT must be libs, symlinks or headers")
endif()

foreach(f ${_old})
    cmake_path(GET f FILENAME _n)
    cmake_path(GET f PARENT_PATH _p)
    message(STATUS "Uninstalling ${_n} from ${_p}/")
    file(REMOVE "${f}")
endforeach()
